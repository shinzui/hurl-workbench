cabal-version: 3.4
name: hurl-workbench-core
version: 0.1.0.0
synopsis: A Haskell-powered Hurl workbench for composing, exploring, executing, and testing reusable API workflows without duplicating request templates.
description:
  A Haskell-powered Hurl workbench for composing, exploring, executing, and testing reusable API workflows without duplicating request templates.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple
extra-doc-files: ../CHANGELOG.md

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    HurlWorkbench.Hurl.Format
    HurlWorkbench.Prelude
    HurlWorkbench.Workflow.Render
    HurlWorkbench.Workflow.Resolve
    HurlWorkbench.Workspace.Context
    HurlWorkbench.Workspace.Decode
    HurlWorkbench.Workspace.Discover
    HurlWorkbench.Workspace.Error
    HurlWorkbench.Workspace.Types
    HurlWorkbench.Workspace.Validate

  other-modules:
    HurlWorkbench.Workspace.Context.Internal

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    containers >=0.6 && <0.8,
    dhall ^>=1.42,
    directory ^>=1.3,
    filepath >=1.4 && <1.6,
    generic-lens ^>=2.3,
    lens ^>=5.3,
    temporary ^>=1.3,
    text ^>=2.1,
    typed-process ^>=0.2.13,

test-suite hurl-workbench-core-test
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    HurlWorkbench.Workflow.WorkflowTest
    HurlWorkbench.Workspace.NameSafetyTest
    HurlWorkbench.Workspace.WorkspaceTest

  ghc-options:
    -threaded

  build-depends:
    base >=4.20 && <5,
    bytestring,
    containers,
    directory,
    filepath,
    generic-lens,
    hurl-workbench-core,
    lens,
    tasty ^>=1.5,
    tasty-hunit ^>=0.10,
    temporary ^>=1.3,
    text,
